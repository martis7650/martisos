// MartisOS Interaktivní Kalkulačka
print("==============================")
print("     MARTISOS KALKULAČKA      ")
print("==============================")

beh = 1
while beh = 1
    print("Zadej první číslo:")
    a = input("a =")
    
    print("Zadej druhé číslo:")
    b = input("b =")
    
    print("Zadej operaci (+, -, *, /):")
    op = input("op =")
    
    if op = "+"
        vysledek = a + b
        print("Výsledek je:")
        print(vysledek)
    elif op = "-"
        vysledek = a - b
        print("Výsledek je:")
        print(vysledek)
    elif op = "*"
        vysledek = a * b
        print("Výsledek je:")
        print(vysledek)
    elif op = "/"
        vysledek = a / b
        print("Výsledek je:")
        print(vysledek)
    else
        print("Neznámá operace!")
        
    print("Chceš pokračovat? (1 = ano, 0 = ne)")
    beh = input("pokracovat =")

print("Kalkulačka byla ukončena. Díky!")
